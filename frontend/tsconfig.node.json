// TypeScript конфигурация за Node.js-side файлове.
//
// Прилага се само за файлове в "include" по-долу (vite.config.ts).
//
// Разлики спрямо tsconfig.app.json:
// - lib: ["ES2023"] (БЕЗ DOM) - vite.config.ts работи в Node.js, не в browser
// - types: ["node"]            - за Node.js globals (process, __dirname и т.н.)
//
// Останалите опции са същите като tsconfig.app.json - строги, type-safe.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts"]
}
